# ===== Telegram =====
# Токен бота от @BotFather. Формат: 1234567890:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot). Формат: 123456789,987654321
ADMIN_IDS=

# ===== Claude API =====
# Ключ с https://platform.claude.com. Формат: sk-ant-api03-xxxxxxxx
ANTHROPIC_API_KEY=

# ===== Threads API (Meta) =====
# Пока пусто — посты не публикуются, только сохраняются.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ===== Настройки =====
# Часовой пояс для расписания
TIMEZONE=Europe/Moscow
# Голос озвучки (edge-tts). Женские: ru-RU-SvetlanaNeural, ru-RU-DariyaNeural
TTS_VOICE=ru-RU-SvetlanaNeural
# Скорость озвучки: +100% = в 2 раза быстрее
TTS_RATE=+100%
# Присылать голосовое к каждому черновику автоматически (1/0)
TTS_AUTO=1
DB_PATH=zavod.db
