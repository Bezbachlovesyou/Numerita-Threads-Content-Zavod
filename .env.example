# ===== Telegram =====
# Токен бота от @BotFather. Формат: 1234567890:AAH-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot). Формат: 123456789,987654321
ADMIN_IDS=

# ===== OpenRouter =====
# Ключ с https://openrouter.ai/keys. Формат: sk-or-v1-xxxxxxxx
OPENROUTER_API_KEY=
# Модель (необязательно). Список: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# ===== Zernio (публикация в Threads) =====
# Ключ: https://zernio.com/dashboard/api-keys. Формат: sk_xxxxxxxx
ZERNIO_API_KEY=
# ID подключённого в Zernio аккаунта Threads (в дашборде Zernio, вида acc_…).
# Пока пусто — посты не публикуются, только сохраняются.
ZERNIO_ACCOUNT_ID=

# ===== Telegram-канал =====
# Куда дублировать посты, например @Numeritalovesyou. Бот должен быть админом канала.
TELEGRAM_CHANNEL=

# ===== Автопостинг =====
# Бот сам выбирает время (днём примерно раз в 70–100 минут, ночью реже, не чаще раза в час) и рубрику
# из prompts/content_plan.md; готовые тексты из prompts/threads_script.md выходят первыми. off — выключить.
AUTOPOST=on
# Картинка-карточка к каждому посту. off — только текст.
CARDS=on

# ===== Автоответы на комментарии в Threads =====
# Включены по умолчанию (0 — выключить). Раз в 5 минут бот отвечает на новые комментарии под своими постами.
AUTOREPLY=1
# Не больше стольких ответов в час.
AUTOREPLY_PER_HOUR=30

# ===== База знаний Numerita =====
# Раз в сутки бот скачивает её и пишет посты по ней. Пусто — без базы.
KB_URL=https://numerita.up.railway.app/kb.json

# ===== Настройки =====
# Часовой пояс для расписания
TIMEZONE=Europe/Moscow
# Голос озвучки (edge-tts). Женские: ru-RU-SvetlanaNeural, ru-RU-DariyaNeural
TTS_VOICE=ru-RU-SvetlanaNeural
# Скорость озвучки: +100% = в 2 раза быстрее
TTS_RATE=+100%
# Присылать голосовое к каждому черновику автоматически (1/0)
TTS_AUTO=1
# База: если задан DATABASE_URL (Postgres, например на Railway) — используется он,
# иначе локальный файл SQLite из DB_PATH.
DATABASE_URL=
DB_PATH=zavod.db

# Видео с Нумеритой (fal.ai → Dashboard → Keys). Без ключа видео не делаются.
FAL_KEY=
# VIDEO_PER_DAY=1
# VIDEO_RESOLUTION=720p
