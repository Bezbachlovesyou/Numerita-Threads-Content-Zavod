# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# Ключ Claude API: https://platform.claude.com
ANTHROPIC_API_KEY=
# Threads API (Meta). Пока пусто — посты не публикуются, только сохраняются.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Часовой пояс для расписания
TIMEZONE=Europe/Moscow
# Голос озвучки (edge-tts). Женские: ru-RU-SvetlanaNeural, ru-RU-DariyaNeural
TTS_VOICE=ru-RU-SvetlanaNeural
# Скорость озвучки: +100% = в 2 раза быстрее
TTS_RATE=+100%
# Присылать голосовое к каждому черновику автоматически (1/0)
TTS_AUTO=1
DB_PATH=zavod.db
